# Keep this file free of real credentials.
# Set one key in your shell. This file is documentation only; v0.1 does not
# load .env automatically.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional ChatGPT App / MCP settings. The private developer-mode server does
# not use OPENAI_API_KEY. Leave LRC_PUBLIC_BASE_URL blank for a temporary
# HTTPS tunnel; it is inferred from the incoming tunnel request.
LRC_PUBLIC_BASE_URL=
LRC_TTL_MINUTES=60
LRC_BATCH_SIZE=4
LRC_MAX_UPLOAD_MB=25
